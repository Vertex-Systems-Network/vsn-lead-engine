# Google auth: set one. User OAuth (authorized_user JSON) is preferred for My Drive.
GOOGLE_OAUTH_USER_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON=
VSN_RUNTIME_CONFIG=config/runtime.json
# Cloudflare R2 registry (required while config/runtime.json registry.mode is "r2").
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Only needed when the Overpass source is enabled. Public instances such as
# overpass-api.de are rejected; use a self-hosted or approved endpoint.
OVERPASS_ENDPOINT=
